# Upstage Studio Agent API — 키는 이 파일을 .env.local 로 복사해 넣고, 절대 커밋하지 않는다
UPSTAGE_API_KEY=
# 워크플로우(에이전트) ID와 제출한 설정 버전. 기본값은 clip 워크플로우 / 설정 #24
UPSTAGE_AGENT_ID=agt_dYaUgJFxXSDceXaB8VcYH2
UPSTAGE_CONFIG_ID=24
# 에이전트가 속한 Project (Studio > API로 이용하기 > code.md 에 나옴)
UPSTAGE_PROJECT_ID=proj_9RWKnzDBjCs8B52ovKjPBQ
# 1 이면 키가 있어도 샘플 결과만 보여 준다 (화면 작업용)
MOCK_MODE=
